{
  "rules": {
    ".read": false,
    ".write": false,

    "obecnosc": {
      ".read": "auth != null",
      "$klucz": {
        ".write": "auth != null && ((auth.token.email === 'host@cyfroweszkoly.pl' && $klucz === 'host') || (auth.token.email === 'tablica@cyfroweszkoly.pl' && $klucz === 'tablica') || (auth.token.email === 'techsupport@cyfroweszkoly.pl' && ($klucz === 'tech' || $klucz === 'stream')) || (auth.token.email === 'zawodnik@cyfroweszkoly.pl' && ($klucz === 'stanowisko1' || $klucz === 'stanowisko2' || $klucz === 'stanowisko3')))"
      }
    },

    "test": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'host@cyfroweszkoly.pl'",
      "zgloszenia": {
        "$stanowisko": {
          ".write": "auth != null && auth.token.email === 'zawodnik@cyfroweszkoly.pl' && !data.exists() && newData.exists()",
          ".validate": "($stanowisko === 'stanowisko1' || $stanowisko === 'stanowisko2' || $stanowisko === 'stanowisko3') && newData.val() === now"
        }
      }
    },

    "gra": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'host@cyfroweszkoly.pl'"
    }
  }
}
