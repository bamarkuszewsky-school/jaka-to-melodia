{
  "rules": {
    ".read": false,
    ".write": false,
    "obecnosc": {
      ".read": "auth != null",
      "$klucz": {
        ".write": "auth != null && ((auth.token.email === 'host@cyfroweszkoly.pl' && $klucz === 'host') || (auth.token.email === 'tablica@cyfroweszkoly.pl' && $klucz === 'tablica') || (auth.token.email === 'techsupport@cyfroweszkoly.pl' && ($klucz === 'tech' || $klucz === 'stream')) || (auth.token.email === 'muzyk@cyfroweszkoly.pl' && $klucz === 'muzyk') || (auth.token.email === 'zawodnik@cyfroweszkoly.pl' && ($klucz === 'stanowisko1' || $klucz === 'stanowisko2' || $klucz === 'stanowisko3')))"
      }
    },
    "test": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'host@cyfroweszkoly.pl'",
      "zgloszenia": {
        "$stanowisko": {
          ".write": "auth != null && auth.token.email === 'zawodnik@cyfroweszkoly.pl' && !data.exists() && newData.exists()",
          ".validate": "($stanowisko === 'stanowisko1' || $stanowisko === 'stanowisko2' || $stanowisko === 'stanowisko3') && newData.val() === now"
        }
      }
    },
    "gra": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'host@cyfroweszkoly.pl'",
      "stanowiska": {
        "$numer": {
          ".validate": "$numer === '1' || $numer === '2' || $numer === '3'",
          "nazwa": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "zgloszenie": {
        ".write": "auth != null && auth.token.email === 'zawodnik@cyfroweszkoly.pl' && !data.exists() && newData.exists() && root.child('gra/pytanie/faza').val() === 'gra' && !root.child('gra/pytanie/zablokowane').child(newData.child('stanowisko').val()).exists()",
        ".validate": "newData.hasChildren(['stanowisko', 'czas']) && (newData.child('stanowisko').val() === '1' || newData.child('stanowisko').val() === '2' || newData.child('stanowisko').val() === '3') && newData.child('czas').val() === now",
        "stanowisko": {
          ".validate": "newData.isString()"
        },
        "czas": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "ruch": {
        ".write": "auth != null && auth.token.email === 'zawodnik@cyfroweszkoly.pl' && !data.exists() && newData.exists() && root.child('gra/pytanie3/faza').val() === 'licytacja' && newData.child('stanowisko').val() === root.child('gra/pytanie3/licytacja/kolej').val()",
        ".validate": "newData.hasChildren(['stanowisko', 'czas']) && newData.child('czas').val() === now",
        "stanowisko": {
          ".validate": "newData.isString()"
        },
        "nuty": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
        },
        "pas": {
          ".validate": "newData.isBoolean()"
        },
        "czas": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "zagrane": {
        ".write": "auth != null && auth.token.email === 'muzyk@cyfroweszkoly.pl' && !data.exists() && newData.exists() && root.child('gra/pytanie3/faza').val() === 'granie'",
        ".validate": "newData.val() === now"
      },
      "stop4": {
        ".write": "auth != null && auth.token.email === 'zawodnik@cyfroweszkoly.pl' && !data.exists() && newData.exists() && root.child('gra/runda4/faza').val() === 'gra' && newData.child('stanowisko').val() === root.child('gra/runda4/gracz').val()",
        ".validate": "newData.hasChildren(['stanowisko', 'czas']) && newData.child('czas').val() === now"
      }
    },
    "muzyk": {
      ".read": "auth != null && (auth.token.email === 'muzyk@cyfroweszkoly.pl' || auth.token.email === 'host@cyfroweszkoly.pl')",
      ".write": "auth != null && auth.token.email === 'host@cyfroweszkoly.pl'"
    }
  }
}
